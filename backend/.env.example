# Reference only. scripts/dev-env.py creates ignored .local/backend.env with a random local password.
# Never source this example to start an application.
APP_ENVIRONMENT=LOCAL
SPRING_PROFILES_ACTIVE=local
PUBLIC_ORIGIN=https://localhost:8443
DB_URL=jdbc:postgresql://127.0.0.1:55432/options_local
DB_USER=options_runtime
DB_PASSWORD=

# Only the migration pool uses the local owner. Never use it as the runtime login.
MIGRATION_DB_USER=options_local
MIGRATION_DB_PASSWORD=
