{
  "name": "options-learning-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.21.x",
    "npm": "11.19.x"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "generate:api": "node scripts/generate-api.mjs",
    "check:api": "node scripts/generate-api.mjs --check",
    "generate:tokens": "node scripts/generate-tokens.mjs",
    "check:tokens": "node scripts/generate-tokens.mjs --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:api && npm run check:tokens && npm test"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "openapi-fetch": "0.17.0",
    "zod": "4.6.5",
    "next": "16.3.6",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "vitest": "5.0.1",
    "jsdom": "30.1.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.7",
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "4.13.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.70.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "@next/eslint-plugin-next": "16.3.6",
    "globals": "16.4.0"
  },
  "type": "module"
}
