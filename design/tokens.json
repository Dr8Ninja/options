{
  "version": "1.0.0",
  "name": "Field notes",
  "themes": {
    "light": {
      "background": "#f7f6f0",
      "surface": "#fffef9",
      "ink": "#202d2b",
      "muted": "#52615d",
      "line": "#c8cfca",
      "control": "#74867c",
      "accent": "#146458",
      "onAccent": "#ffffff",
      "soft": "#e4eee7",
      "warning": "#87501a",
      "warningSurface": "#fbefd8",
      "danger": "#a73833",
      "dangerSurface": "#fae9e5",
      "focus": "#005fba"
    },
    "dark": {
      "background": "#141d1c",
      "surface": "#1c2826",
      "ink": "#eef3ec",
      "muted": "#a6b6ad",
      "line": "#43524c",
      "control": "#7c9389",
      "accent": "#a4d2bd",
      "onAccent": "#13231c",
      "soft": "#263d32",
      "warning": "#e9c28b",
      "warningSurface": "#372d20",
      "danger": "#ffb5ac",
      "dangerSurface": "#3f2826",
      "focus": "#8ec5ff"
    }
  },
  "typography": {
    "interface": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "editorial": "Georgia, \"Times New Roman\", serif",
    "mono": "ui-monospace, SFMono-Regular, Consolas, monospace",
    "sizesRem": {
      "caption": 0.8125,
      "small": 0.875,
      "body": 1,
      "reading": 1.1875,
      "lead": 1.125,
      "h3": 1.25,
      "h2": 2,
      "h1Min": 2.25,
      "h1Max": 3.5,
      "heroMax": 4.75
    },
    "lineHeights": {
      "heading": 1.12,
      "interface": 1.55,
      "reading": 1.75
    }
  },
  "spacingPx": [
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64,
    96
  ],
  "layout": {
    "maxWidthPx": 1248,
    "readingCh": 66,
    "railPx": 232,
    "tocPx": 176,
    "gutterMobilePx": 20,
    "gutterDesktopPx": 40,
    "breakpointsPx": [
      640,
      960,
      1200
    ]
  },
  "radiusPx": {
    "control": 6,
    "panel": 10,
    "pill": 999
  },
  "borderPx": 1,
  "focus": {
    "widthPx": 3,
    "offsetPx": 3
  },
  "elevation": {
    "panel": "none",
    "dialog": "0 20px 64px rgba(0,0,0,.25)"
  },
  "targets": {
    "minPx": 44,
    "gapPx": 8
  },
  "motion": {
    "durationMs": 120,
    "reducedDurationMs": 0
  }
}
